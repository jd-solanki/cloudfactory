{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aisubs-gw",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The container runs the real aisubs API. It is there for two reasons: a
  // deployed Worker cannot reach chatgpt.com (403 bot page) and aisubs'
  // protocol translation (dist/compatibility.js) is not in the package exports
  // map, so it cannot be bundled into a Worker at all.
  //
  // lite = 1/16 vCPU, 256 MiB, 2 GB disk: the smallest instance, which is all a
  // Fastify proxy needs. max_instances 1 because it is stateless and this
  // account is shared with production projects.
  "containers": [
    {
      "class_name": "AisubsContainer",
      "image": "./container/Dockerfile",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],

  "durable_objects": {
    "bindings": [
      // Holds the OAuth credential. aisubs' modify() is a read-then-write, so it
      // needs a critical section; one DO instance in one isolate provides it.
      {
        "name": "CREDENTIAL_STORE",
        "class_name": "CredentialStoreDO",
      },
      // Backs the container.
      {
        "name": "AISUBS_CONTAINER",
        "class_name": "AisubsContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CredentialStoreDO", "AisubsContainer"],
    },
  ],

  "secrets_store_secrets": [
    // The key end users paste into OPENAI_API_KEY. Checked by the Worker before
    // the container is woken, and again by aisubs inside the container.
    {
      "binding": "GATEWAY_KEY",
      "store_id": "dbe91e8e7bed44c2b0618abf954eac6e",
      "secret_name": "AISUBS_GATEWAY_KEY",
    },
    // Guards /internal/credential, the container's callback into the Durable
    // Object. Never leaves the Cloudflare network.
    {
      "binding": "EGRESS_KEY",
      "store_id": "dbe91e8e7bed44c2b0618abf954eac6e",
      "secret_name": "AISUBS_EGRESS_KEY",
    },
  ],

  // Cloudflare has no hard spend cap, so cost is bounded in code instead.
  // Both limits run before the container is woken. Note the binding is
  // per-Cloudflare-location, so a distributed caller sees limit x colos; it
  // bounds an ordinary runaway client, not a determined attacker.
  "ratelimits": [
    // Per caller IP. Generous for one human, hostile to a retry loop.
    {
      "name": "IP_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 10 },
    },
    // Across every caller. The guard for a leaked gateway key.
    {
      "name": "GLOBAL_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],

  // Bounds a single runaway invocation. Streaming passthrough spends almost no
  // CPU - it is wall-clock bound - so this is far above normal use.
  "limits": {
    "cpu_ms": 30000,
  },

  // No cron trigger on purpose. OpenAI rotates the refresh token on every use,
  // so the container must be the only refresher. A Worker cron calling
  // getAccessToken() would race it and invalidate one of the two tokens.
}
